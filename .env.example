# ==========================================
# SERVER CONFIGURATION (server/.env)
# ==========================================
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college_events
JWT_SECRET=super_secret_college_event_jwt_key_2026

# Firebase Admin (Optional - fill in if using Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# CLIENT CONFIGURATION (client/.env)
# ==========================================
# Leave empty in development to utilize the Vite proxy (/api -> http://localhost:5000)
VITE_API_BASE_URL=

# Firebase Auth Client Keys (Optional - built-in demo auth works without setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
